#!/usr/bin/python3
# Exact command allowed by /etc/sudoers.d/flipper-runner (no wildcards).
import subprocess
from flipper_tool import emit, status
r = subprocess.run(["sudo", "-n", "/usr/bin/systemctl", "stop", "kismet.service"],
                   capture_output=True, text=True, timeout=40)
if r.returncode == 0:
    emit(status("ok", "Kismet stopped", title="Kismet"))
else:
    emit(status("error", "systemctl stop failed (rc %d); see journalctl -u kismet" % r.returncode, title="Kismet"))
