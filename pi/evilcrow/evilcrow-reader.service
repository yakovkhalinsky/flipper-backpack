[Unit]
Description=Evil Crow RF V2 receive-only USB serial reader
After=multi-user.target
# Do not bind hard to a device unit: the Crow may be unplugged.

[Service]
Type=simple
User=flipper-runner
Group=flipper-runner
SupplementaryGroups=dialout
ExecStart=/usr/bin/python3 /opt/flipper-runner/evilcrow_reader.py --port /dev/evilcrow
WorkingDirectory=/opt/flipper-runner
Environment=PYTHONPATH=/opt/flipper-runner PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/flipper-runner/evilcrow.env
Restart=always
RestartSec=3
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
LockPersonality=yes
UMask=0077
RuntimeDirectory=flipper-runner
RuntimeDirectoryMode=0700
# Read-only root except the runtime dir for the capture ring.
ReadWritePaths=

[Install]
WantedBy=multi-user.target
